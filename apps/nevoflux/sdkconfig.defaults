CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions.csv"

# 8MB Octal PSRAM + External mbedTLS allocation (keeps >180KB internal SRAM free)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Explicitly disable Bluetooth in ota_1 to save ~300KB Flash and ~45KB internal SRAM
CONFIG_BT_ENABLED=n

# Task Watchdog Timer (10 seconds timeout, panic/reset on stall)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# Native USB Serial/JTAG for PC provisioning
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# LVGL 9
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_BUILD_EXAMPLES=n

# SoftAP is never used (STA only)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# app_main runs panel/LVGL/WiFi init plus 1.3KB RPC line buffers; 3584 default overflows
# The main loop also decodes the spoken replies (Opus), which wants a few KB more
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Internal RAM is shared by the LVGL DMA buffers, I2S DMA, task stacks and Wi-Fi;
# with two WebSocket clients + TLS the Wi-Fi driver ran dry ("wifi:m f null").
# Anything >= 4 KB without explicit caps (WebSocket buffers, cJSON, frames) goes to PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Fewer static (internal, 1.6 KB each) Wi-Fi RX buffers; dynamic ones come from PSRAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10

# The uplink carries ~45 KB/s of base64 PCM while held; with lwIP's 5.7 KB
# send buffer and a hotspot's ~200 ms RTT a socket moves under 30 KB/s, so the
# buffer filled, a write timed out and the WebSocket dropped mid-utterance.
# lwIP buffers live in PSRAM (SPIRAM_TRY_ALLOCATE_WIFI_LWIP).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# Pin the address of the relay / account host to one that answers (nf_resolve.c):
# on a hotspot one Cloudflare address can go dead while the other works.
CONFIG_LWIP_HOOK_NETCONN_EXT_RESOLVE_CUSTOM=y
